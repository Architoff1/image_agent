# Streamlit Secrets Template
# Copy these values into Streamlit Community Cloud:
# App Settings -> Secrets (TOML format)

# Groq API configuration
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"
GROQ_TIMEOUT = 120
GROQ_MAX_TOOL_ROUNDS = 12
GROQ_MAX_EDIT_ATTEMPTS = 4

# Kaggle GPU Backend configuration (from your active Kaggle session)
GPU_BACKEND_URL = "https://your-kaggle-ngrok-url.ngrok-free.dev"
GPU_BACKEND_TOKEN = "your-kaggle-token"
GPU_BACKEND_TIMEOUT = 900

# FastAPI Backend (auto-starts embedded inside Streamlit Cloud on port 8000)
# You can leave this as http://127.0.0.1:8000 or omit it.
LOCAL_AGENT_API_URL = "http://127.0.0.1:8000"
API_REQUEST_TIMEOUT = 1200
