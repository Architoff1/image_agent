# Groq reasoning and tool-calling controller (local laptop)
GROQ_API_KEY="YOUR_API_KEY"
# Choose a model currently available to your Groq account with tool-calling support.
GROQ_MODEL= openai/gpt-oss-120b
GROQ_TIMEOUT=120
GROQ_MAX_TOOL_ROUNDS=12
GROQ_MAX_EDIT_ATTEMPTS=4
GROQ_MAX_MASK_ATTEMPTS_PER_STRATEGY=3

IMAGE_EDIT_DEFAULT_STEPS=28
IMAGE_EDIT_DEFAULT_GUIDANCE=30.0
IMAGE_EDIT_DEFAULT_STRENGTH=0.95
#IMAGE_EDIT_DEFAULT_SEED=12345

TAVILY_API_KEY="YOU_TAVILY_API"

# Kaggle GPU backend: HTTPS base URL only; do not append /v1/edit
GPU_BACKEND_URL="https://unsetting-chelsea-unturbidly.ngrok-free.dev/"
GPU_BACKEND_TOKEN="YOUR_TOKEN"
GPU_BACKEND_TIMEOUT=900

# Streamlit talks to the local FastAPI app, never directly to Kaggle
LOCAL_AGENT_API_URL=http://127.0.0.1:8000
API_REQUEST_TIMEOUT=1200

# Local persistence paths (optional)
APP_DATA_DIR=data
OUTPUT_DIR=data/outputs
